[Unit]
Description=Homebridge Kiosk panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homebridge
WorkingDirectory=/opt/homebridge-kiosk
EnvironmentFile=/opt/homebridge-kiosk/.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
